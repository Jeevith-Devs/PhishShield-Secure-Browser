{
  "manifest_version": 3,
  "name": "PhishShield: Threat Detection & Risk-Adaptive Shield",
  "version": "1.0.0",
  "description": "Defensive cybersecurity browser extension for real-time phishing detection, risk scoring, and controlled investigation.",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background/service_worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "PhishShield Status",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/interstitial/interstitial.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
