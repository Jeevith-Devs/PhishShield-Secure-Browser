{
  "manifest_version": 3,
  "name": "PhishShield: Threat Detection & Risk-Adaptive Shield",
  "version": "1.0.0",
  "description": "Defensive cybersecurity browser extension for real-time phishing detection, risk scoring, and controlled investigation.",
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "PhishShield Status"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
